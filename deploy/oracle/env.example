# Copy to .env on the server and fill the values from your Render dashboard (Environment tab).
# Never commit the real .env. Never paste these values in chat.
DOMAIN=yourname.duckdns.org
DB_URI=
UI_ACCESS_KEY=
DEEPSEEK_API_KEY=
# Copy every other variable that is set on Render (check the Environment tab), for example:
# ALLOWED_ORIGINS=
# NOTES_PASSWORD=
# OWNER_PHONE=
# GIVELIFE_STORAGE_KEY=
# BRAVE_SEARCH_API_KEY=
# Do NOT copy: PORT, DATA_DIR, RENDER_* (set by compose or not needed).
# After the move works, set a bigger gateway memory limit if you like (Render needed a small one):
# GOMEMLIMIT=800MiB
